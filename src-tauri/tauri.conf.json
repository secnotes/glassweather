{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlassWeather",
  "version": "0.2.0",
  "identifier": "com.secnotes.weather",
  "build": {
    "beforeDevCommand": "node copy-frontend.js",
    "beforeBuildCommand": "node copy-frontend.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "windows": [
      {
        "title": "GlassWeather",
        "label": "main",
        "width": 1120,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "实时天气 · 7 天预报 · 30 年今日历史",
    "longDescription": "查询任意城市实时天气与未来 7 天预报，并展示今天这个日期在过去 30 年的历史天气（最大降水、最高温、最低温、降水天数）。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
